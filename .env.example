# Optional. Without these, DeepTrace runs as a browser-only demo workspace.
# With them, workspace routes require sign-in and data is stored in Supabase
# behind row-level security. Set them in Vercel → Project → Settings →
# Environment Variables, then redeploy (they are read at build time).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# DeepTrace never uses a service-role key. Do not add one.

# Optional: where the contact form delivers messages (https URL).
CONTACT_WEBHOOK_URL=
